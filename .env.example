FLASK_ENV=development
SECRET_KEY=change-me-in-production-secure-32-bytes
JWT_SECRET_KEY=change-me-jwt-secret-key-secure-32-bytes

# Database Configuration (MySQL / SQLite)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fraud_detection
DB_USER=fraud_app_user
DB_PASSWORD=change-me
# DATABASE_URL=sqlite:///database/fraud_detection.db

# Machine Learning Artifact Paths
MODEL_ARTIFACT_PATH=ml/artifacts/model.joblib
PREPROCESSOR_ARTIFACT_PATH=ml/artifacts/preprocessor.joblib
FEATURE_NAMES_PATH=ml/artifacts/feature_names.json

# Adaptive Risk Policy Thresholds
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70

# OTP & Multi-Factor Security
OTP_EXPIRY_SECONDS=180
OTP_MAX_ATTEMPTS=3

# SMS Provider Configuration (Twilio / Mock / Development)
SMS_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email & SMTP Delivery Configuration (Phase 5 & 7.1)
# Options for MAIL_PROVIDER / EMAIL_PROVIDER:
#   - 'development': In-memory recording for local automated tests & local development
#   - 'smtp': Live SMTP network delivery (supports Gmail, SendGrid, Amazon SES, Mailgun, etc.)
#   - 'null': Strict production fallback that honestly reports unconfigured mail server
MAIL_PROVIDER=development

# SMTP / Mail Server Settings (both MAIL_* and SMTP_* names are supported):
# Examples:
#   Gmail: MAIL_SERVER=smtp.gmail.com | MAIL_PORT=587 | MAIL_USE_TLS=true (Requires 16-character App Password)
#   SendGrid: MAIL_SERVER=smtp.sendgrid.net | MAIL_PORT=587 | MAIL_USERNAME=apikey
#   Custom: MAIL_SERVER=smtp.yourdomain.com | MAIL_PORT=465 | MAIL_USE_SSL=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=security@fraudshield.ai
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Alternative SMTP_* naming conventions also fully supported:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_FROM_EMAIL=security@fraudshield.ai
SMTP_FROM_NAME=FraudShield AI Security
APP_PUBLIC_URL=http://127.0.0.1:5000

# Password Reset Policies
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_WINDOW=3
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

