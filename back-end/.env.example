FLASK_ENV=development
SECRET_KEY=change-me-in-production-secure-32-bytes
JWT_SECRET_KEY=change-me-jwt-secret-key-secure-32-bytes

# Database Configuration (PostgreSQL / MySQL / SQLite)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fraud_detection
DB_USER=fraud_app_user
DB_PASSWORD=change-me

# Machine Learning Artifact Paths
MODEL_ARTIFACT_PATH=ml/artifacts/model.joblib
PREPROCESSOR_ARTIFACT_PATH=ml/artifacts/preprocessor.joblib
FEATURE_NAMES_PATH=ml/artifacts/feature_names.json

# Adaptive Risk Policy Thresholds
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70

# OTP & Multi-Factor Security
OTP_EXPIRY_SECONDS=180
OTP_MAX_ATTEMPTS=3

# SMS Provider Configuration (Twilio / Mock / Development)
SMS_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==============================================================================
# Email Delivery Configuration (Resend HTTPS API / SMTP / Development)
# ==============================================================================
# Options for EMAIL_PROVIDER / MAIL_PROVIDER:
#   - 'resend': Official Resend HTTPS REST API (Recommended for Render / Production)
#   - 'smtp': Live SMTP network delivery (Local / dedicated servers)
#   - 'development': In-memory recording for local automated tests & local development
#   - 'null': Fallback reporting unconfigured mail service
EMAIL_PROVIDER=resend
MAIL_PROVIDER=resend

# Resend HTTPS API Configuration (Port 443 - Bypasses Render SMTP port blocking)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=FraudShield AI Security
RESEND_REPLY_TO=

# Alternative / Fallback SMTP Server Settings (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=security@fraudshield.ai
MAIL_USE_TLS=true
MAIL_USE_SSL=false
SMTP_FROM_NAME=FraudShield AI Security

APP_PUBLIC_URL=http://127.0.0.1:5000

# Password Reset Policies
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_WINDOW=3
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
